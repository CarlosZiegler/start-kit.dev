{
	"name": "create-start-kit-dev",
	"version": "0.1.11",
	"description": "Create full-stack TypeScript SaaS apps with TanStack Start, Bun, Drizzle, Better-Auth, and Stripe in seconds",
	"type": "module",
	"license": "MIT",
	"author": {
		"name": "Carlos Ziegler",
		"url": "https://github.com/CarlosZiegler"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/CarlosZiegler/start-kit.dev",
		"directory": "packages/cli"
	},
	"homepage": "https://start-kit.dev",
	"bugs": {
		"url": "https://github.com/CarlosZiegler/start-kit.dev/issues"
	},
	"keywords": [
		"cli",
		"create-app",
		"starter",
		"starter-kit",
		"saas",
		"boilerplate",
		"template",
		"scaffold",
		"tanstack",
		"tanstack-start",
		"react",
		"fullstack",
		"typescript",
		"bun",
		"drizzle",
		"better-auth",
		"stripe",
		"orpc"
	],
	"bin": {
		"create-start-kit-dev": "./dist/index.mjs"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"publish:latest": "bun run build && npm login && npm publish --tag latest",
		"release": "bun run build && npm publish --tag latest && git tag v$(node -p \"require('./package.json').version\") && git push --tags"
	},
	"dependencies": {
		"@clack/prompts": "^1.1.0",
		"giget": "^3.1.2",
		"picocolors": "^1.1.1"
	},
	"devDependencies": {
		"@types/bun": "^1.3.10",
		"tsdown": "^0.21.4",
		"typescript": "^5.9.3"
	},
	"publishConfig": {
		"access": "public",
		"tag": "latest"
	},
	"engines": {
		"node": ">=18.0.0",
		"bun": ">=1.0.0"
	},
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/CarlosZiegler"
	}
}
